# BANNER 70 — environment variables for the Vercel Functions in api/.
# Set these in Vercel: Project Settings > Environment Variables. Never commit real values.

# Stripe (Dashboard > Developers > API keys / Webhooks). Use values from the same mode/account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the BANNER 70 product (price_...). Only purchases of this price trigger delivery.
STRIPE_PRICE_ID=

# Public URL of this site, without a trailing slash.
SITE_URL=https://banner70.an-yaku.com

# Resend (https://resend.com). MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM="BANNER 70 <no-reply@an-yaku.com>"
MAIL_REPLY_TO=contact@anyaku.co.jp
CONTACT_URL=https://anyaku.co.jp/contact/

# Download policy
DOWNLOAD_LINK_TTL_DAYS=30
DOWNLOAD_MAX_COUNT=5
FIGMA_FILE_PATHNAME="BANNER 70.fig"

# Set automatically by Vercel integrations:
# Vercel Blob (private store)  -> BLOB_READ_WRITE_TOKEN
# Upstash Redis (Marketplace)  -> KV_REST_API_URL, KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN)
